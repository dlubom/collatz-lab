#!/bin/sh

set -eu

blocked=0

while read -r _local_ref _local_oid remote_ref _remote_oid; do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            echo "Blocked: direct pushes to '$remote_ref' are not allowed." >&2
            echo "Push a topic branch and deliver the change through a pull request." >&2
            blocked=1
            ;;
    esac
done

exit "$blocked"
